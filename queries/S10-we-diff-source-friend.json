        "HAS_INTEREST",
        "HAS_TYPE"
      ],
      "transitions": [
        [
          "q0",
          "KNOWS-",
          "q0"
        ],
        [
          "q0",
          "HAS_INTEREST-",
          "q1"
        ],
        [
          "q1",
          "HAS_TYPE-",
          "q2"
        ]
      ],
      "initial_states": [
        "q0"
      ],
      "final_states": [
        "q2"
      ]
    },
    "P2": {
      "regular_expression": "KNOWS*/HAS_INTEREST/HAS_TYPE",
      "states": [
        "q0",
        "q1",
        "q2"
      ],
      "alphabets": [
        "KNOWS",
        "HAS_INTEREST",
        "HAS_TYPE"
      ],
      "transitions": [
        [
          "q0",
          "KNOWS-",
          "q0"
        ],
        [
          "q0",
          "HAS_INTEREST-",
          "q1"
        ],
        [
          "q1",
          "HAS_TYPE-",
          "q2"
        ]
      ],
      "initial_states": [
        "q0"
      ],
      "final_states": [
        "q2"
      ]
    }
  },
  "word_equality_constraints": [
    {
      "path1": "P1",
      "path2": "P2",
      "source_constraint": "different",
      "linking_label": "KNOWS"
